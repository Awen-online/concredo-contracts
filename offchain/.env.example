# Copy to offchain/.env (gitignored) and fill in. Never commit .env.
# Every variable is optional: with none set, the scaffold uses Koios public tier on preprod.

# Network. The scaffold refuses Mainnet.
CARDANO_NETWORK=Preprod

# Primary and fallback chain providers: koios | blockfrost | kupmios | none
CARDANO_PROVIDER=koios
CARDANO_PROVIDER_FALLBACK=none
# To use Blockfrost as a fallback, create a preprod project and switch it on:
# CARDANO_PROVIDER_FALLBACK=blockfrost

# Koios (no key needed for the public tier; a free registered token raises limits)
KOIOS_URL=https://preprod.koios.rest/api/v1
KOIOS_TOKEN=

# Blockfrost (free Starter plan; one project per network, the token is network specific)
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
BLOCKFROST_PROJECT_ID=

# Kupo + Ogmios ("kupmios"): self-hosted, Yaci DevKit, or a hosted endpoint
# Yaci DevKit defaults (assumed, check `devkit` output): Ogmios 1337, Kupo 1442
KUPO_URL=
OGMIOS_URL=
